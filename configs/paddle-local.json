{
  "version": 1,
  "execution": {"workers": 4, "on_error": "fail"},
  "layout": {
    "provider": "paddle", "model": "layout", "coordinates": "pixel",
    "type_map": {"paragraph_title": "heading", "image": "image", "formula": "formula"}
  },
  "models": {
    "layout": {
      "backend": "onnx", "path": "../models/layout.onnx", "instances": 1,
      "preprocess": {"width": 800, "height": 800, "mean": [0.485, 0.456, 0.406], "std": [0.229, 0.224, 0.225]},
      "inputs": [{"name": "image", "source": "image"}, {"name": "scale_factor", "source": "scale_factor"}],
      "decoder": {
        "type": "paddle_layout", "output_index": 0, "coordinates": "pixel", "score_threshold": 0.5,
        "labels": ["paragraph_title", "image", "text", "number", "abstract", "content", "figure_title", "formula", "table", "table_title", "reference", "doc_title", "footnote", "header", "algorithm", "footer", "seal"]
      }
    },
    "text_om": {
      "backend": "acl", "path": "../models/text_rec.om", "instances": 2, "device_ids": [0],
      "preprocess": {"width": 320, "height": 48, "mean": [0.5, 0.5, 0.5], "std": [0.5, 0.5, 0.5]},
      "inputs": [{"name": "x", "source": "image"}],
      "decoder": {"type": "ctc", "output_index": 0, "blank_index": 0, "dictionary": "../models/ctc_vocab_with_blank.txt"}
    },
    "structure": {
      "backend": "vllm", "instances": 2,
      "endpoint": "http://127.0.0.1:8000/v1/chat/completions", "model": "paddleocr-vl"
    }
  },
  "routes": {
    "text": {"model": "text_om"},
    "heading": {"model": "text_om"},
    "table": {"model": "structure", "prompt": "Table Recognition:"},
    "formula": {"model": "structure", "prompt": "Formula Recognition:"},
    "image": {"action": "image"},
    "*": {"model": "structure", "prompt": "OCR:"}
  }
}
